# Copy to the directory printed by:
#   herdr plugin config-dir herdr-touchbar
# as `.env`, then restart the app: bash bin/run.sh restart
#
# Exporting these in a shell does not work — the app is launched through `open`,
# which does not pass the caller's environment along.

# Show only agents that are working or waiting on you, hiding idle ones.
# HERDR_TOUCHBAR_ONLY_ACTIVE=1

# Pin the order instead of following herdr's ui.agent_panel_sort: spaces | priority
# HERDR_TOUCHBAR_SORT=priority

# Which terminal to raise when you tap an agent. Auto-detected otherwise.
# HERDR_TOUCHBAR_TERMINAL_BUNDLE_ID=com.mitchellh.ghostty

# herdr control socket, if it is not at ~/.config/herdr/herdr.sock
# HERDR_SOCKET_PATH=/path/to/herdr.sock

# Verbose logging to ~/Library/Logs/herdr-touchbar.log
# HERDR_TOUCHBAR_DEBUG=1
